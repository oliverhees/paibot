{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "biome.json",
    "tsconfig.base.json",
    "tools/lint-regeln/*.grit"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@paibot/db#test": {
      "dependsOn": ["^build", "@paibot/web#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
