// PaiBot – Lint-Regel: Test-Zugänge der Pakete nur in Tests: `@paibot/<paket>/testing` (auch mit
// Unterpfad) und relative Pfade auf eine Datei oder einen Ordner `testing` (`./testing`,
// `../testing.ts`, `./testing/hilfe`). Ein Pfad, der erst zur Laufzeit entsteht, ist nicht erkennbar.
//
// Autor:     Oliver Hees
// Website:   https://paibot.de
// Copyright: 2026 Oliver Hees. Alle Urheberrechte liegen beim Autor.
// Lizenz:    PaiBot Fair-Code-Lizenz 1.1 – siehe Datei LICENSE im Projektstamm
// Seit:      2026-11-20

language js

`$source` where {
  $source <: or {
    r"^[\"'`]@paibot/[a-z-]+/testing(/[^\"'`]*)?[\"'`]$",
    r"^[\"'`](\.\.?/)+([^\"'`]*/)?testing(\.ts|/[^\"'`]*)?[\"'`]$"
  },
  register_diagnostic(span=$source, message="Test-Zugänge (`@paibot/*/testing`) gehören nur in Tests (*.test.ts).")
}
