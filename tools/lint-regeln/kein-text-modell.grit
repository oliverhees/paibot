language js

`$fn($args)` where {
  $fn <: or {
    `streamText`,
    `generateText`,
    `streamObject`,
    `generateObject`,
    `embed`,
    `embedMany`
  },
  $args <: contains `model: $model` where { $model <: r"^[\"'`].*" },
  register_diagnostic(span=$model, message="Modelle nie als Text-Kennung angeben, nur als Modell-Objekt aus der Anbieter-Schicht.")
}
