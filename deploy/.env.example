# Am einfachsten: sh deploy/env-erzeugen.sh – das legt deploy/.env mit Zufallswerten an.
# Von Hand: diese Datei nach deploy/.env kopieren und jeden leeren Wert füllen.
# Die .env-Datei nie committen.

# Besitzer der Tabellen, nur für die Migrationen beim Start.
POSTGRES_USER=paibot
# mindestens 24 Zeichen, nur Buchstaben und Ziffern, z. B.: openssl rand -hex 32
POSTGRES_PASSWORD=

# Eingeschränkte Rolle, mit der die App arbeitet (wird beim ersten Start angelegt).
POSTGRES_APP_USER=paibot_app
# mindestens 24 Zeichen, nur Buchstaben und Ziffern, z. B.: openssl rand -hex 32
POSTGRES_APP_PASSWORD=

POSTGRES_DB=paibot

# Wurzel-Geheimnis, genau 32 Byte als Base64: openssl rand -base64 32
PAIBOT_SECRET=

APP_URL=https://paibot.example.de
WEB_PORT=3000

# Optional: wie viele Antworten der Worker gleichzeitig bearbeitet (Standard 2).
PAIBOT_WORKER_CONCURRENCY=2

# Datenschleuse (Standard: aus). Einschalten: die zwei Zeilen ohne # übernehmen und
# pnpm schleuse:config --env-datei deploy/.env ausführen (docs/funktion-datenschleuse.md).
# COMPOSE_PROFILES=schleuse
# SCHLEUSE_URL=http://datenschleuse:4000/v1
# Zugangsschlüssel zwischen PaiBot und Datenschleuse: "sk-" und 64 Hex-Zeichen,
# z. B.: echo "sk-$(openssl rand -hex 32)"
SCHLEUSE_KEY=
# Schlüssel für den verschlüsselten Zwischenstand: openssl rand -base64 32 | tr '+/' '-_'
SCHLEUSE_STATE_KEY=
# Wie der Schlüssel deines Modell-Anbieters zur Datenschleuse kommt:
#   anfrage (Standard): PaiBot schickt ihn mit jeder Anfrage mit; er liegt nur verschlüsselt in PaiBot.
#   umgebung (Rückfall): die Datenschleuse liest ihn aus SCHLEUSE_ANBIETER_SCHLUESSEL (nur ein Anbieter).
SCHLEUSE_SCHLUESSEL_WEG=anfrage
# Nur bei SCHLEUSE_SCHLUESSEL_WEG=umgebung: derselbe Schlüssel wie in PaiBot. Sonst leer lassen.
SCHLEUSE_ANBIETER_SCHLUESSEL=
# de_core_news_md (Standard) oder de_core_news_lg (mehr Speicher, dann SCHLEUSE_ANALYZER_SPEICHER=1536m)
SCHLEUSE_SPRACHMODELL=de_core_news_md
