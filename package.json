{
  "name": "paibot",
  "version": "0.3.0-dev",
  "private": true,
  "description": "PaiBot – dein persönliches KI-Team, EU-souverän und selbst gehostet.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/doku-index.mjs && turbo run dev --filter=@paibot/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:notices": "node scripts/third-party-notices.mjs",
    "headers:check": "node scripts/headers.mjs --check",
    "headers:write": "node scripts/headers.mjs --write",
    "doku:app": "node scripts/doku/app.mjs",
    "doku:beispieldaten": "node scripts/doku-beispieldaten.mjs",
    "doku:screenshots": "node scripts/doku-screenshots.mjs",
    "doku:check": "node scripts/doku-check.mjs",
    "doku:index": "node scripts/doku-index.mjs",
    "compose:vergleich": "node scripts/compose-vergleich.mjs",
    "e2e": "turbo run build --output-logs=errors-only && node tools/e2e/src/e2e.mjs",
    "schleuse:config": "node scripts/schleuse-config.mjs",
    "belege:pruefen": "turbo run build --filter=@paibot/receipts --output-logs=errors-only && node packages/receipts/dist/belege-pruefen.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
