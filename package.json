{
  "name": "paibot",
  "private": true,
  "description": "Paibot – dein persönliches KI-Team, EU-souverän und selbst gehostet.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@paibot/web",
