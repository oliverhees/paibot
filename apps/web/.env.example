# Lokale Entwicklung mit der Datenbank aus Docker:
#   docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.entwicklung.yml \
#     --env-file deploy/.env up -d postgres
# Die Passwörter stehen in deploy/.env (POSTGRES_APP_PASSWORD bzw. POSTGRES_PASSWORD).

# Rolle der App (eingeschränkt)
DATABASE_URL=postgres://paibot_app:POSTGRES_APP_PASSWORD_aus_deploy_env@localhost:5432/paibot
# Rolle für die Migrationen beim Start (Besitzer der Tabellen)
DATABASE_MIGRATION_URL=postgres://paibot:POSTGRES_PASSWORD_aus_deploy_env@localhost:5432/paibot
APP_URL=http://localhost:3000
